{
  "name": "@xtendedtechs/whatsapp-gateway",
  "version": "0.1.0",
  "description": "Tiny, generic WhatsApp Business Cloud API gateway: send templates + verify webhooks. Zero runtime deps, framework-agnostic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "author": "xtendedtechs",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtendedtechs-com/whatsupp-gateway.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business",
    "whatsapp-cloud-api",
    "meta",
    "graph-api",
    "webhook",
    "messaging",
    "template"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
